{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LyangPOS",
  "version": "0.1.0",
  "identifier": "com.lyangpos.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5002",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LyangPOS",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "bin/lyang-backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["Vietnamese"],
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "macos": {
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
